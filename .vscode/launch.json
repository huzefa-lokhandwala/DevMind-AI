{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DevMind AI: main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "DevMind AI: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "tests"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
