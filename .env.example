# Copy to .env and fill in values as features are added.
# Primary LLM Provider: Google Gemini (Server-side secret; required for primary AI generation)
# GEMINI_API_KEY=

# Fallback LLM Provider 1: OpenRouter (Server-side secret; optional fallback)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=30.0

# Fallback LLM Provider 2: xAI Grok (Server-side secret; optional fallback)
# XAI_API_KEY=
# XAI_MODEL=grok-2-latest
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_TIMEOUT_SECONDS=30.0

# Embedding Provider Configuration
# Development / Offline default: EMBEDDING_PROVIDER=local (BAAI/bge-small-en-v1.5, 384d)
# Production default: EMBEDDING_PROVIDER=gemini (gemini-embedding-2, 768d)
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=50
# Local provider settings (for EMBEDDING_PROVIDER=local):
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIMENSION=384
# EMBEDDING_BATCH_SIZE=1
# EMBEDDING_THREADS=1
# MAX_FILE_SIZE_BYTES=524288
# REPOSITORY_PROCESS_BATCH_SIZE=10
# INDEX_MEMORY_LIMIT_MB=400

# Application Environment (development, testing, production)
DEVMIND_ENV=development

# Backend Security (API Key Header: X-API-Key)
DEVMIND_API_KEY=

# User Authentication (JWT)
JWT_SECRET=devmind_local_development_jwt_secret_key_minimum_32_bytes_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (Comma-separated allowed origin URLs)
CORS_ORIGINS=http://localhost:3000

# Database Configuration (Local Development Defaults)
DATABASE_URL=postgresql+psycopg://devmind:devmind_local@localhost:5432/devmind
POSTGRES_DB=devmind
POSTGRES_USER=devmind
POSTGRES_PASSWORD=devmind_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend Configuration (Browser-accessible API base URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
