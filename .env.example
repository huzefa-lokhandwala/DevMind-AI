# Copy to .env and fill in values as features are added.
# Gemini LLM Provider Key (Required for AI generation; not required for local embeddings)
# GEMINI_API_KEY=
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIMENSION=384
# EMBEDDING_BATCH_SIZE=1
# EMBEDDING_THREADS=1
# MAX_FILE_SIZE_BYTES=524288
# REPOSITORY_PROCESS_BATCH_SIZE=5
# INDEX_MEMORY_LIMIT_MB=400

# Application Environment (development, testing, production)
DEVMIND_ENV=development

# Backend Security (API Key Header: X-API-Key)
DEVMIND_API_KEY=

# CORS Configuration (Comma-separated allowed origin URLs)
CORS_ORIGINS=http://localhost:3000

# Database Configuration (Local Development Defaults)
DATABASE_URL=postgresql+psycopg://devmind:devmind_local@localhost:5432/devmind
POSTGRES_DB=devmind
POSTGRES_USER=devmind
POSTGRES_PASSWORD=devmind_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend Configuration (Browser-accessible API base URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
