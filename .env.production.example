# Production Environment Configuration Template (.env.production)
# Copy to .env in production deployment environments.

# Application Environment (MUST be set to 'production' in live deployments)
DEVMIND_ENV=production

# Primary LLM Provider Key (Required for LLM answer generation; local embeddings require no API key)
GEMINI_API_KEY=your_production_gemini_api_key_here

# Fallback LLM Provider 1: OpenRouter (Optional production fallback on Gemini rate limits/5xx)
# OPENROUTER_API_KEY=your_production_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=30.0

# Fallback LLM Provider 2: xAI Grok (Optional production fallback on OpenRouter failure)
# XAI_API_KEY=your_production_xai_api_key_here
# XAI_MODEL=grok-2-latest
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_TIMEOUT_SECONDS=30.0
# Embedding Provider Configuration (Production uses Gemini Embedding 2 with 768d)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=50
MAX_FILE_SIZE_BYTES=524288
REPOSITORY_PROCESS_BATCH_SIZE=10
INDEX_MEMORY_LIMIT_MB=400

# Backend Authentication Secret (Mandatory in production mode - fail-closed policy)
DEVMIND_API_KEY=generate_strong_random_secret_key_here

# User Authentication (JWT - Mandatory in production mode - minimum 32 chars)
JWT_SECRET=generate_strong_random_jwt_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (Set to exact production frontend domain URLs)
CORS_ORIGINS=https://devmind.example.com,https://app.devmind.example.com

# Frontend API Target URL (Host-accessible HTTPS URL)
NEXT_PUBLIC_API_BASE_URL=https://api.devmind.example.com

# Production Database Configuration (Managed PostgreSQL / RDS / Cloud SQL)
DATABASE_URL=postgresql+psycopg://user:password@prod-db-host:5432/devmind_prod
POSTGRES_DB=devmind_prod
POSTGRES_USER=devmind_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=prod-db-host
POSTGRES_PORT=5432
